# Perpetua build-time configuration (Vite). Copy to `.env` for local builds;
# CI/release passes these as environment variables (see .github/workflows/release.yml
# and build-release.ps1). None of these are secrets — every value is shown to
# the customer — but they decide what the shipped app points at.
#
# Backend (Rust) build-time variables live alongside these but are NOT Vite
# vars: PERPETUA_LICENSE_SECRET (secret, required for release builds) and
# POLAR_ORGANIZATION_ID (public id, required for in-app Polar activation).

# Polar checkout link for the Pro lifetime unlock (Polar dashboard → Products →
# Checkout Links). Must be https. When unset the in-app "Buy" button falls back
# to VITE_PERPETUA_PRODUCT_URL and is labelled accordingly.
VITE_PERPETUA_CHECKOUT_URL=

# Price shown in the paywall. Must match the Polar product exactly; Polar adds
# tax at checkout. Default: $49.99
VITE_PERPETUA_PRO_PRICE=$49.99

# Public product page. Default: https://perpetua.hammurabi.click
VITE_PERPETUA_PRODUCT_URL=https://perpetua.hammurabi.click

# Support mailbox shown in-app. Must be a monitored address and match legal/SUPPORT.md.
VITE_PERPETUA_SUPPORT_EMAIL=support@hammurabi.click

# Local API port. Keep in sync with PERPETUA_API_PORT for the Rust side. Default: 18765
# VITE_PERPETUA_API_PORT=18765
