{
  // Markdown lint config for Perpetua docs.
  "config": {
    "default": true,
    "MD013": false, // line length — prose wraps freely
    "MD024": { "siblings_only": true }, // allow repeated headings in different sections
    "MD033": false, // inline HTML allowed
    "MD041": false, // first line need not be a top-level heading
  },
  "globs": ["README.md", "docs/**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules",
    "build",
    ".svelte-kit",
    "src-tauri",
    "docs/archive",
  ],
}
