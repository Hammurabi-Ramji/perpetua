{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "group": "build",
      "presentation": {
        "panel": "shared",
        "reveal": "never"
      },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      }
    }
  ]
}