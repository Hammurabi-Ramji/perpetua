{
  "name": "licensevault-vscode",
  "displayName": "LicenseVault",
  "description": "Manage software licenses directly in VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "licensevault.login",
        "title": "Login to LicenseVault",
        "category": "LicenseVault"
      },
      {
        "command": "licensevault.logout",
        "title": "Logout from LicenseVault",
        "category": "LicenseVault"
      },
      {
        "command": "licensevault.refresh",
        "title": "Refresh Licenses",
        "category": "LicenseVault"
      },
      {
        "command": "licensevault.openDashboard",
        "title": "Open LicenseVault Dashboard",
        "category": "LicenseVault"
      },
      {
        "command": "licensevault.addLicense",
        "title": "Add License Manually",
        "category": "LicenseVault"
      },
      {
        "command": "licensevault.searchLicenses",
        "title": "Search Licenses",
        "category": "LicenseVault"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "licensevault.explorer",
          "name": "LicenseVault",
          "icon": "$(key)",
          "contextualTitle": "LicenseVault"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "licensevault.refresh",
          "when": "view == licensevault.explorer",
          "group": "navigation"
        },
        {
          "command": "licensevault.addLicense",
          "when": "view == licensevault.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "licensevault.copyLicenseKey",
          "when": "view == licensevault.explorer && viewItem == licenseItem",
          "group": "7_modification@1"
        },
        {
          "command": "licensevault.editLicense",
          "when": "view == licensevault.explorer && viewItem == licenseItem",
          "group": "7_modification@2"
        },
        {
          "command": "licensevault.deleteLicense",
          "when": "view == licensevault.explorer && viewItem == licenseItem",
          "group": "7_modification@3"
        }
      ]
    },
    "configuration": {
      "title": "LicenseVault",
      "properties": {
        "licensevault.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Base URL for the LicenseVault API"
        },
        "licensevault.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh licenses on startup"
        },
        "licensevault.showExpired": {
          "type": "boolean",
          "default": true,
          "description": "Show expired licenses in the tree view"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^20.17.57",
    "eslint": "^8.0.0",
    "typescript": "^4.4.3",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}
