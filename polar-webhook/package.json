{
  "name": "perpetua-polar-webhook",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Cloudflare Worker that receives and verifies Polar.sh webhook events for Perpetua. Not part of the Tauri desktop app.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.0-alpha.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^4.129.0"
  }
}
