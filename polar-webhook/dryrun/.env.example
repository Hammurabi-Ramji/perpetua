# Copy to a LOCAL, git-ignored file (or export in your shell). Never commit real values.
# Everything here is for the Polar SANDBOX only (dryrun/sandbox.test.ts). The offline
# mock dry-run (purchase-to-activate.test.ts) needs only PERPETUA_BIN; it generates its own
# throwaway secrets per run.

# perpetua binary built by desktop/scripts/build-polar-dryrun-binary.ps1 (-Mode mock | sandbox)
PERPETUA_BIN=

# --- sandbox runbook values ---
# Sandbox organization id (public identifier; same value you pass to the build script)
POLAR_SANDBOX_ORG_ID=
# Worker under test: `npx wrangler dev` (http://127.0.0.1:8787) or a deployed *.workers.dev URL,
# configured with POLAR_API_BASE=https://sandbox-api.polar.sh and SANDBOX secrets
POLAR_SANDBOX_WORKER_URL=
# License key emailed by a real sandbox purchase (100%-off discount code)
POLAR_SANDBOX_LICENSE_KEY=
# Optional: sandbox webhook endpoint secret (enables the signed-event check)
POLAR_SANDBOX_WEBHOOK_SECRET=
# Optional: key from a sandbox order you refunded (enables the revocation check)
POLAR_SANDBOX_REVOKED_KEY=
