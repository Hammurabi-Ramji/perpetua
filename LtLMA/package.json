{
  "name": "perpetua",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "test": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test",
    "spell": "cspell --no-progress --no-must-find-files \"**/*.md\" \"src/**/*.{ts,svelte}\" \"e2e/**/*.ts\" \"src-tauri/src/**/*.rs\"",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.0.0-beta.0",
    "@tauri-apps/plugin-shell": "^2.0.0-beta.0",
    "@testing-library/svelte": "^5.2.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cspell": "^10.0.1",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.30.0",
    "jsdom": "^26.1.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.1.2",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/plugin-dialog": "^2.0.0-beta.0",
    "@tauri-apps/plugin-fs": "^2.0.0-beta.0",
    "@tauri-apps/plugin-os": "^2.0.0-beta.0",
    "@tauri-apps/plugin-store": "^2.0.0-beta.0",
    "autoprefixer": "^10.5.0",
    "tailwindcss": "^4.3.0",
    "tesseract.js": "^7.0.0"
  }
}
