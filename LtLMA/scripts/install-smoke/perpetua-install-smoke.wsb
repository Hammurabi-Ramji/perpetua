<!--
  Windows Sandbox config for the Perpetua install smoke.
  STATUS: Built, NOT run. Windows Sandbox was not available on the authoring host
  (C:\Windows\System32\WindowsSandbox.exe absent => feature not enabled).

  Before use:
    1. Enable "Windows Sandbox" (elevated PowerShell, then reboot):
         Enable-WindowsOptionalFeature -Online -FeatureName Containers-DisposableClientVM -All
    2. Edit the two HostFolder paths below if your repo is not at C:\IEDB\PERPETUA.
       - Installers are mapped READ-ONLY.
       - Results folder is writable; create it first:  mkdir C:\IEDB\PERPETUA\audit-artifacts\install-smoke
    3. Double-click this file.  The sandbox runs the script, writes results.json/results.md/logs to the
       results folder, then stays open (so you can eyeball the UI) - close it to discard everything.

  To smoke the NSIS installer instead, change the -Installer argument below to
  C:\smoke\bundle\nsis\Perpetua_1.0.0_x64-setup.exe  (only exists after .\build-release.ps1 produces it).
  Networking is left enabled on purpose: the MSI downloads the WebView2 bootstrapper if the guest lacks it.
-->
<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\IEDB\PERPETUA\LtLMA\src-tauri\target\release\bundle</HostFolder>
      <SandboxFolder>C:\smoke\bundle</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\IEDB\PERPETUA\LtLMA\scripts\install-smoke</HostFolder>
      <SandboxFolder>C:\smoke\scripts</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\IEDB\PERPETUA\audit-artifacts\install-smoke</HostFolder>
      <SandboxFolder>C:\smoke\results</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -Command "&amp; 'C:\smoke\scripts\Run-InstallSmoke.ps1' -Installer 'C:\smoke\bundle\msi\Perpetua_1.0.0_x64_en-US.msi' -LogDir 'C:\smoke\results' -IUnderstandThisInstalls"</Command>
  </LogonCommand>
</Configuration>
