{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main Perpetua window: core APIs plus shell/dialog/fs/os/notification/autostart used by the desktop shell (tray, reminders, vault helpers).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "os:default",
    "notification:default",
    "autostart:default"
  ]
}
